{
  "name": "pi-duplex",
  "version": "0.1.0",
  "description": "A duplex coding agent for Pi",
  "type": "module",
  "license": "MIT",
  "author": "shaqq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaqq/pi-duplex.git"
  },
  "homepage": "https://github.com/shaqq/pi-duplex#readme",
  "bugs": {
    "url": "https://github.com/shaqq/pi-duplex/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "duplex"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "start": "pi -e ./src/extension.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "release:check": "npm run check && node ./scripts/verify-package.mjs",
    "prepack": "npm run release:check"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "24.13.3",
    "typebox": "1.3.15",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
